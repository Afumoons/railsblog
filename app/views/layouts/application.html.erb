<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Railsblog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Railsblog">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-zinc-50 text-zinc-900 antialiased">
    <% if authenticated? %>
      <div data-controller="sidebar">
        <div class="fixed inset-0 z-30 hidden bg-zinc-950/40 backdrop-blur-sm lg:hidden" data-sidebar-target="backdrop" data-action="click->sidebar#close"></div>

        <aside class="fixed inset-y-0 left-0 z-40 flex w-72 -translate-x-full flex-col bg-zinc-950 px-4 py-5 text-zinc-300 shadow-2xl transition-transform duration-200 lg:translate-x-0" data-sidebar-target="panel">
          <div class="flex items-center justify-between px-2">
            <%= link_to root_path, class: "flex items-center gap-3 text-white", data: { action: "click->sidebar#close" } do %>
              <span class="grid size-9 place-items-center rounded-xl bg-white text-sm font-semibold tracking-tight text-zinc-950">RB</span>
              <span class="text-sm font-semibold tracking-tight">Railsblog Admin</span>
            <% end %>
            <button type="button" class="grid size-9 place-items-center rounded-lg text-zinc-400 hover:bg-white/10 hover:text-white lg:hidden" aria-label="Close navigation" data-action="click->sidebar#close">
              <svg aria-hidden="true" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="m6 18 12-12M6 6l12 12" /></svg>
            </button>
          </div>

          <nav class="mt-10 flex-1 space-y-1" aria-label="Main navigation">
            <%= link_to root_path, class: "flex items-center gap-3 rounded-lg bg-white/10 px-3 py-2.5 text-sm font-medium text-white", data: { action: "click->sidebar#close" } do %>
              <svg aria-hidden="true" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 13h6v8H3zm12-10h6v18h-6zM3 3h6v6H3zm12 5h6v6h-6z" /></svg>
              Overview
            <% end %>

            <details class="group" open>
              <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2.5 text-sm font-medium text-zinc-300 hover:bg-white/10 hover:text-white">
                <span class="flex items-center gap-3"><svg aria-hidden="true" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 5.75A2.75 2.75 0 0 1 6.75 3h10.5A2.75 2.75 0 0 1 20 5.75v12.5A2.75 2.75 0 0 1 17.25 21H6.75A2.75 2.75 0 0 1 4 18.25zM8 7h8M8 11h8M8 15h5" /></svg>Content</span>
                <svg aria-hidden="true" class="size-4 transition group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="m6 9 6 6 6-6" /></svg>
              </summary>
              <div class="ml-5 mt-1 space-y-1 border-l border-white/10 pl-5">
                <%= link_to "All posts", posts_path, class: "block rounded-md px-3 py-2 text-sm text-zinc-400 hover:bg-white/10 hover:text-white", data: { action: "click->sidebar#close" } %>
                <%= link_to "Create post", new_post_path, class: "block rounded-md px-3 py-2 text-sm text-zinc-400 hover:bg-white/10 hover:text-white", data: { action: "click->sidebar#close" } %>
              </div>
            </details>

            <details class="group">
              <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2.5 text-sm font-medium text-zinc-300 hover:bg-white/10 hover:text-white">
                <span class="flex items-center gap-3"><svg aria-hidden="true" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06-2.12 2.12-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V20.2h-3v-.08a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06-2.12-2.12.06-.06A1.65 1.65 0 0 0 7.18 15a1.65 1.65 0 0 0-1.51-1H5.6v-3h.08a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06L8.92 6l.06.06A1.65 1.65 0 0 0 10.8 6.4a1.65 1.65 0 0 0 1-1.51V4.8h3v.08a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06 2.12 2.12-.06.06A1.65 1.65 0 0 0 19.4 10c.13.6.67 1 1.28 1h.08v3h-.08c-.61 0-1.15.4-1.28 1Z" /></svg>Account</span>
                <svg aria-hidden="true" class="size-4 transition group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="m6 9 6 6 6-6" /></svg>
              </summary>
              <div class="ml-5 mt-1 border-l border-white/10 pl-5">
                <p class="px-3 py-2 text-xs leading-5 text-zinc-500"><%= Current.user.email_address %></p>
              </div>
            </details>
          </nav>

          <div class="border-t border-white/10 pt-4">
            <div class="mb-3 flex items-center gap-3 px-3">
              <span class="grid size-9 place-items-center rounded-full bg-zinc-800 text-xs font-semibold text-zinc-200"><%= Current.user.email_address.first.upcase %></span>
              <div class="min-w-0"><p class="truncate text-sm font-medium text-white"><%= Current.user.email_address %></p><p class="text-xs text-zinc-500">Administrator</p></div>
            </div>
            <%= button_to session_path, method: :delete, class: "flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-zinc-300 hover:bg-rose-500/10 hover:text-rose-300" do %>
              <svg aria-hidden="true" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6A2.25 2.25 0 0 0 5.25 5.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m-3-3h7.5m0 0-3-3m3 3-3 3" /></svg>
              Sign out
            <% end %>
          </div>
        </aside>

        <div class="min-h-screen lg:pl-72">
          <header class="sticky top-0 z-20 flex h-16 items-center justify-between border-b border-zinc-200 bg-white/90 px-4 backdrop-blur lg:px-8">
            <button type="button" class="grid size-10 place-items-center rounded-lg text-zinc-600 hover:bg-zinc-100 lg:hidden" aria-label="Open navigation" data-action="click->sidebar#toggle">
              <svg aria-hidden="true" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 6h16M4 12h16M4 18h16" /></svg>
            </button>
            <div class="hidden text-sm text-zinc-500 sm:block">Content management workspace</div>
            <div class="flex items-center gap-3"><span class="hidden text-sm text-zinc-500 sm:block"><%= Current.user.email_address %></span><span class="grid size-9 place-items-center rounded-full bg-zinc-900 text-xs font-semibold text-white"><%= Current.user.email_address.first.upcase %></span></div>
          </header>

          <main class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
            <% if notice.present? %><div class="mb-6 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800 ring-1 ring-emerald-200"><%= notice %></div><% end %>
            <% if alert.present? %><div class="mb-6 rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-800 ring-1 ring-rose-200"><%= alert %></div><% end %>
            <%= yield %>
          </main>

          <footer class="border-t border-zinc-200 px-4 py-6 text-sm text-zinc-500 sm:px-6 lg:px-8"><div class="mx-auto flex max-w-7xl flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"><span>© <%= Time.current.year %> Railsblog. All rights reserved.</span><span>Admin workspace</span></div></footer>
        </div>
      </div>
    <% else %>
      <main class="mx-auto flex min-h-screen max-w-md items-center px-5 py-12"><%= yield %></main>
    <% end %>
  </body>
</html>
