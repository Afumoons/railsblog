<% content_for :title, "Posts" %>

<section class="space-y-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-medium text-zinc-500">Overview</p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight text-zinc-950">Publishing dashboard</h1>
      <p class="mt-2 text-sm text-zinc-600">Manage your content and monitor activity from one focused workspace.</p>
    </div>
    <%= link_to new_post_path, class: "inline-flex items-center justify-center gap-2 rounded-lg bg-zinc-950 px-4 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:ring-offset-2" do %>
      <svg aria-hidden="true" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.5v15m7.5-7.5h-15" /></svg>
      New post
    <% end %>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    <div class="rounded-xl bg-white p-5 shadow-[0_0_0_1px_rgba(0,0,0,0.08),0_2px_2px_rgba(0,0,0,0.04)]"><p class="text-sm font-medium text-zinc-500">Published posts</p><p class="mt-3 text-3xl font-semibold tracking-tight text-zinc-950"><%= @post_count %></p><p class="mt-2 text-sm text-zinc-500">Available in your content library</p></div>
    <div class="rounded-xl bg-white p-5 shadow-[0_0_0_1px_rgba(0,0,0,0.08),0_2px_2px_rgba(0,0,0,0.04)]"><p class="text-sm font-medium text-zinc-500">Reader comments</p><p class="mt-3 text-3xl font-semibold tracking-tight text-zinc-950"><%= @comment_count %></p><p class="mt-2 text-sm text-zinc-500">Across all published posts</p></div>
    <div class="rounded-xl bg-zinc-950 p-5 text-white shadow-[0_0_0_1px_rgba(0,0,0,0.08),0_2px_2px_rgba(0,0,0,0.12)] sm:col-span-2 xl:col-span-1"><p class="text-sm font-medium text-zinc-400">Workspace status</p><div class="mt-3 flex items-center gap-2"><span class="size-2 rounded-full bg-emerald-400"></span><p class="text-xl font-semibold tracking-tight">Ready to publish</p></div><p class="mt-2 text-sm text-zinc-400">Your dashboard is connected and operational.</p></div>
  </div>

  <section class="overflow-hidden rounded-xl bg-white shadow-[0_0_0_1px_rgba(0,0,0,0.08),0_2px_2px_rgba(0,0,0,0.04)]">
    <div class="flex items-center justify-between border-b border-zinc-100 px-5 py-4"><div><h2 class="font-semibold tracking-tight text-zinc-950">Recent posts</h2><p class="mt-1 text-sm text-zinc-500">Your most recently updated content.</p></div><%= link_to "View all", posts_path, class: "text-sm font-medium text-zinc-700 hover:text-zinc-950" %></div>
    <% if @posts.any? %>
      <div class="divide-y divide-zinc-100">
        <% @posts.first(5).each do |post| %>
          <div class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0"><%= link_to post.title.presence || "Untitled post", post_path(post), class: "block truncate font-medium text-zinc-950 hover:underline" %><p class="mt-1 truncate text-sm text-zinc-500"><%= post.body.to_plain_text.presence || "No content yet" %></p></div>
            <div class="flex shrink-0 items-center gap-4 text-sm text-zinc-500"><span><%= pluralize(post.comments.size, "comment") %></span><%= link_to "Edit", edit_post_path(post), class: "font-medium text-zinc-700 hover:text-zinc-950" %></div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-5 py-12 text-center"><p class="font-medium text-zinc-950">Your content library is empty</p><p class="mt-2 text-sm text-zinc-500">Create your first post to start publishing.</p><%= link_to "Create post", new_post_path, class: "mt-5 inline-flex rounded-lg bg-zinc-950 px-4 py-2 text-sm font-medium text-white hover:bg-zinc-800" %></div>
    <% end %>
  </section>
</section>
